{
  "name": "food-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/customer",
    "apps/admin",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@food-platform/customer",
    "build": "npm run build --workspace=@food-platform/customer",
    "start": "npm run start --workspace=@food-platform/customer",
    "lint": "npm run lint --workspace=@food-platform/customer",
    "typecheck": "npm run typecheck --workspace=@food-platform/customer",
    "dev:admin": "npm run dev --workspace=@food-platform/admin",
    "build:admin": "npm run build --workspace=@food-platform/admin",
    "typecheck:admin": "npm run typecheck --workspace=@food-platform/admin",
    "test:admin": "npm run test:permissions --workspace=@food-platform/admin",
    "dev:customer": "npm run dev --workspace=@food-platform/customer",
    "build:customer": "npm run build --workspace=@food-platform/customer",
    "lint:customer": "npm run lint --workspace=@food-platform/customer",
    "typecheck:customer": "npm run typecheck --workspace=@food-platform/customer",
    "test:customer": "npm run test --workspace=@food-platform/customer",
    "typecheck:shared": "tsc --project packages/shared/tsconfig.json",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:link": "supabase link --project-ref wvvzrdmydwmicoxeggdb",
    "supabase:migrations": "supabase migration list --remote",
    "supabase:types": "supabase gen types typescript --remote --schema public"
  }
}
