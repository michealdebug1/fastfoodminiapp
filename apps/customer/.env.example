# Browser-safe Supabase project configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Trusted server-only key used by Telegram identity routes. Never prefix it
# with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-only Telegram bot credentials. Configure them only in trusted server
# environments; never expose or commit their values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Use a random 32+ character token. Production webhook setup is a separate step.
TELEGRAM_WEBHOOK_SECRET=
